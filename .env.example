# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Sinh chuỗi ngẫu nhiên:  python -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=
INTERNAL_API_TOKEN=            # token dùng giữa các service (header X-Internal-Token)

MYSQL_ROOT_PASSWORD=
USER_DB_PASSWORD=
CATALOG_DB_PASSWORD=
ORDER_DB_PASSWORD=
PROMOTION_DB_PASSWORD=
WEB_DB_PASSWORD=

# Địa chỉ người dùng truy cập (qua gateway)
GATEWAY_PORT=8088
PUBLIC_HOST=localhost:8088
PUBLIC_SCHEME=http
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# Superuser cho Django admin (/admin/ và /admin/catalog/) – chỉ tạo khi cả 2 biến có giá trị
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# Email đặt lại mật khẩu. Mặc định in ra log của user-service (console).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Dùng SMTP thật:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
