  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Cách đọc dashboard",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "options": {
        "mode": "markdown",
        "content": "**Nguồn số liệu:** Prometheus (django-prometheus, cAdvisor, node-exporter) · CloudWatch (ALB, Container Insights) · X-Ray (trace từ aws-xray-sdk).\n\n**Độ lệch KHÔNG phải lúc nào cũng là lỗi đo.** Nguyên nhân thường gặp: (1) *phạm vi khác nhau*: ALB chỉ thấy request vào qua load balancer, Prometheus đếm theo từng service Django; nginx tự phục vụ `/static/` nên không có trong Prometheus; (2) *chu kỳ lấy mẫu*: Prometheus scrape 15s, CloudWatch gộp theo phút, Container Insights ~60s; (3) *định nghĩa chỉ số*: CPU/RAM từ cAdvisor và từ CloudWatch agent tính hơi khác; (4) *lấy mẫu trace*: X-Ray chỉ ghi phần request được sample (đang đặt 100% trừ health/metrics) và trễ vài chục giây; (5) *làm tròn theo bước thời gian*. Hãy xem **xu hướng và độ lệch ổn định**, đừng so từng điểm.\n\nBiến `cluster` là tên cluster EKS (khớp nhãn `ClusterName` của Container Insights)."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Số request/phút: Prometheus (web + ảnh /media) vs ALB RequestCount",
      "description": "Prometheus = web + catalog phục vụ /media (các đường đi qua ALB → gateway), bỏ health và /metrics. CloudWatch = AWS/ApplicationELB RequestCount (Sum, 1 phút).",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(django_http_responses_total_by_status_view_method_total{service=\"web\",view!~\"greenmart_common.health.health|django_prometheus.exports.ExportToDjangoView\"}[1m])) + sum(increase(django_http_responses_total_by_status_view_method_total{service=\"catalog-service\",view=\"django.views.static.serve\"}[1m]))",
          "legendFormat": "Prometheus (web + /media)",
          "interval": "1m",
          "hide": false,
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "B",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensions": {
            "LoadBalancer": [
              "*"
            ]
          },
          "matchExact": false,
          "statistic": "Sum",
          "period": "60",
          "region": "default",
          "label": "ALB RequestCount",
          "id": "",
          "expression": "",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
